# Copy this file to ".env" and adjust the values. The real .env is never committed to Git.

# Port the app listens on
PORT=3000

# "development" for local work, "production" when you deploy.
# Production turns on HTTPS-only cookies and refuses to start without a real SESSION_SECRET.
NODE_ENV=development

# REQUIRED: a long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Optional settings (remove the # to use them) ----

# Where the SQLite database file lives (default: ./database/messaging.db)
# DB_PATH=./database/messaging.db

# How many days a login lasts (default: 7)
# SESSION_DAYS=7

# bcrypt cost factor for password hashing (default: 10, allowed: 4-15)
# BCRYPT_ROUNDS=10

# Sign-up attempts allowed per network address per hour (default: 30).
# Raise it if a big group registers from one shared connection.
# REGISTER_LIMIT_PER_HOUR=30

# Behind nginx / a hosting platform that terminates HTTPS: number of proxies to trust
# TRUST_PROXY=1

# Force the session cookie "secure" flag on or off (default: on in production only)
# COOKIE_SECURE=true

# Extra browser origins allowed to open the Socket.IO connection (comma separated).
# Only needed if a proxy changes the Host header.
# ALLOWED_ORIGINS=https://chat.example.com
